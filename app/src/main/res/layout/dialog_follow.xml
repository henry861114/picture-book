<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/follow_title"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/follow_hint"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:tint="@color/muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnPrevSentence"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="10dp"
            android:text="@string/prev_sentence"
            android:textColor="@color/green_700"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sentenceCounter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnNextSentence"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:text="@string/next_sentence"
            android:textColor="@color/green_700"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/followSentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_follow_sentence"
        android:fontFamily="serif"
        android:lineSpacingExtra="3dp"
        android:minHeight="88dp"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:textColor="@color/ink"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/followTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <com.henry.greenisland.WaveformView
        android:id="@+id/waveform"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/recordTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="00:00"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnListen"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_secondary"
            android:clickable="true"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="4dp"
            android:drawableTint="@color/green_700"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/listen_original"
            android:textColor="@color/green_700"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnRecord"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_record_button"
                android:contentDescription="@string/start_record"
                android:padding="18dp"
                android:src="@drawable/ic_mic"
                android:tint="@color/white" />

            <TextView
                android:id="@+id/recordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/start_record"
                android:textColor="@color/coral"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPlayback"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:alpha="0.4"
            android:background="@drawable/bg_dialog_secondary"
            android:clickable="false"
            android:drawableStart="@drawable/ic_replay"
            android:drawablePadding="4dp"
            android:drawableTint="@color/green_700"
            android:focusable="false"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/playback"
            android:textColor="@color/green_700"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/followTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center"
        android:text="@string/record_tip"
        android:textColor="@color/muted"
        android:textSize="10sp" />
</LinearLayout>
